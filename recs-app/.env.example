# Supabase — copy this file to `.env` and fill in from your Supabase project:
# Dashboard → Project Settings → Data API (URL) and API Keys (anon / publishable key).
# EXPO_PUBLIC_ vars are inlined into the app at build time by Expo. Never put the
# service_role / secret key here — it must never ship in the client.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-anon-or-publishable-key

# Optional (A4 book search). Google Books basic search works with no key, but the
# shared keyless quota is low; add a key to raise it. Cloud Console → APIs &
# Services → enable "Books API" → create an API key. Leave unset to stay keyless.
# EXPO_PUBLIC_GOOGLE_BOOKS_API_KEY=
